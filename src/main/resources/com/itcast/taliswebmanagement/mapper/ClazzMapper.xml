<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itcast.taliswebmanagement.mapper.ClazzMapper">

    <!--班级列表数据的条件分页查询-->
    <select id="page" resultType="com.itcast.taliswebmanagement.pojo.Clazz">
        SELECT c.*,
               e.name master_name,
               (CASE WHEN CURRENT_DATE &gt; c.end_date THEN '已结课'
                     WHEN CURRENT_DATE &lt; c.begin_date THEN '未开班'
                     ELSE '在读中' END) AS status
        FROM clazz c LEFT JOIN emp e ON c.master_id = e.id
        <where>
            <if test="name != null and name != ''">
                c.name LIKE CONCAT('%',#{name},'%')
            </if>
            <if test="begin != null and end != null">
                AND (c.begin_date BETWEEN #{begin} AND #{end}
                OR c.end_date BETWEEN #{begin} AND #{end})
            </if>
            <if test="begin != null and end == null">
                AND c.begin_date &gt;= #{begin}
            </if>
            <if test="begin == null and end != null">
                AND c.end_date &lt;= #{end}
            </if>
        </where>
        ORDER BY c.update_time DESC
    </select>

    <!--保存班级信息-->
    <insert id="insert">
        INSERT INTO clazz(name,room,begin_date,end_date,master_id,subject,create_time,update_time)
        VALUES(#{name},#{room},#{beginDate},#{endDate},#{masterId},#{subject},#{createTime},#{updateTime})
    </insert>

    <!--根据ID查询班级-->
    <select id="getClazzById" resultType="com.itcast.taliswebmanagement.pojo.Clazz">
        select
            id,name,room,begin_date,end_date,master_id,subject,create_time,update_time
        from clazz
        where id = #{id}
    </select>

    <!--查询所有班级-->
    <select id="list" resultType="com.itcast.taliswebmanagement.pojo.Clazz">
        select
            id,name,room,begin_date,end_date,master_id,subject,create_time,update_time
        from clazz
    </select>



    <!--修改班级-->
    <!--    参数用驼峰命名（beginDate），数据库字段用下划线（begin_date）-->
    <update id="updateClazz">
        UPDATE clazz
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="room != null and room != ''">room = #{room},</if>
            <if test="beginDate != null">begin_date = #{beginDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="masterId != null">master_id = #{masterId},</if>
            <if test="subject != null">subject = #{subject},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!--删除班级-->
    <delete id="deleteClazzById">
        DELETE FROM clazz WHERE id = #{id}
    </delete>
</mapper>